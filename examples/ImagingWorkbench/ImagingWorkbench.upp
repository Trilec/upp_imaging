description "Interactive imaging workbench MVP";

uses
	CtrlLib,
	Ui,
	imaging_histogram,
	imaging_preview_coalescing,
	imaging_tone_conversion,
	imaging_roundtrip_test_support,
	imaging_roundtrip_viewer_ocio,
	imaging_view_transform,
	openimageio_util_src,
	oiio,
	opencolorio;

options
	-I../openimageio_util_src,
	-I../openimageio_headers;

file
	ImagingWorkbench.generated.cpp,
	ImagingCanvas.cpp,
	ImagingWorkbench.cpp,
	main.cpp,
	README.md;

mainconfig
	"" = "GUI";
