description "OpenImageIO TIFF plugin backed by bundled libtiff 4.7.2";

uses
	openimageio_headers,
	openimageio_src,
	openimageio_plugins_src,
	libtiff_src,
	zlib;

options
	-I../openimageio_src,
	-I../openimageio_src/upstream/libOpenImageIO,
	-I../libtiff_src/generated,
	-I../libtiff_src/upstream/libtiff,
	-DOIIO_STATIC_DEFINE=1;

file
	import.ext,
	RegisterTIFF.h,
	RegisterTIFF.cpp,
	README.md;
