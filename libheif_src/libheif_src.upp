description "Pinned libheif 1.23.1 decode-only HEIF/AVIF container backend";

noblitz;

uses
	dav1d_src,
	libde265_src;

include
	config,
	upstream/libheif,
	upstream/libheif/api;

options
	-std=c++20,
	-DLIBHEIF_STATIC_BUILD=1,
	-DLIBHEIF_EXPORTS=1,
	-DHAVE_DAV1D=1,
	-DHAVE_LIBDE265=1;

file
	import.ext,
	config/libheif/heif_version.h,
	README.md;
