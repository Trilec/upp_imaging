description "OpenImageIO standard JPEG backed by repository libjpeg-turbo 3.2.0";
uses
    openimageio_headers,
    openimageio_src,
    openimageio_plugins_src,
    libjpeg_turbo,
    libtiff_src;
options
    -I../openimageio_src,
    -I../openimageio_src/upstream/libOpenImageIO,
    -I../../codecs/libjpeg_turbo_src/generated,
    -I../../codecs/libjpeg_turbo_src/upstream/src,
    -I../../codecs/libtiff_src/generated,
    -I../../codecs/libtiff_src/upstream/libtiff,
    -DOIIO_STATIC_DEFINE=1;
file
    import.ext,
    RegisterJPEG.h,
    RegisterJPEG.cpp,
    README.md;
