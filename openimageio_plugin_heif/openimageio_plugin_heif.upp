description "OpenImageIO HEIF/AVIF input plugin backed by decode-only libheif 1.23.1";

uses
	openimageio_headers,
	openimageio_src,
	openimageio_plugins_src,
	libheif_src;

options
	-I../openimageio_src,
	-I../openimageio_src/upstream/libOpenImageIO,
	-DOIIO_STATIC_DEFINE=1;

file
	import.ext,
	RegisterHEIF.h,
	RegisterHEIF.cpp,
	README.md;
