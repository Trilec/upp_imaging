description "Stable application-facing OpenImageIO package";

uses
	openimageio_headers,
	openimageio_src,
	openimageio_plugin_openexr,
	openimageio_plugin_png,
	openimageio_plugin_jpegxl,
	openimageio_plugin_hdr,
	openimageio_plugin_dpxcineon,
	openimageio_plugin_raw,
	openimageio_plugin_webp,
	openimageio_plugin_heif,
	openimageio_plugin_tiff;

file
	OIIO.h,
	OIIO.cpp,
	README.md;
