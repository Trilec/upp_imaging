description "OpenImageIO WebP plugin backed by pinned libwebp 1.6.0";

uses
	openimageio_headers,
	openimageio_src,
	openimageio_plugins_src,
	webp_src,
	libtiff;

options
	-I../openimageio_src,
	-I../openimageio_src/upstream/libOpenImageIO,
	-I../webp_src,
	-I../webp_src/upstream,
	-I../webp_src/upstream/src,
	-I../libtiff,
	-DOIIO_STATIC_DEFINE=1,
	-DHAVE_CONFIG_H=1;

file
	import.ext,
	WebPOutput.cpp,
	RegisterWebP.h,
	RegisterWebP.cpp,
	README.md;
